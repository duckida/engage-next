{
  "name": "engage-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "dev:demo": "cross-env ENGAGE_DEMO=1 npm run dev",
    "build": "node scripts/build-api.mjs && vite build",
    "build:web": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/**/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.2.5",
    "@tanstack/react-query": "^5.66.0",
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.2.4",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "tough-cookie": "^5.1.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/tough-cookie": "^4.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
