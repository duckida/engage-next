# Copy to .env for local development (optional — dev generates a temporary one).

# Required on Vercel. Any long random string; it encrypts the session cookie.
# Generate one with:  openssl rand -hex 32
# Changing it signs everyone out.
SESSION_SECRET=

# Set to 1 to serve invented fixture data instead of a real school portal.
# ENGAGE_DEMO=1

# Local server binding (defaults shown).
# HOST=127.0.0.1
# PORT=8787
